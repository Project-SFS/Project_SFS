# ============================================================================
# Solve For Sakthi - backend settings
# Used by `docker compose up` and by `npm run dev` (in backend/).
# ============================================================================

# ---- Server ----
PORT=9022
# production = hide internal error details from API responses
NODE_ENV=production

# ---- Database (SQL Server) ----
# Fill in the real SQL Server details.
# Use host.docker.internal if SQL Server runs on this same server (outside Docker).
DB_HOST=your-sql-server-host
DB_PORT=1433
DB_NAME=SakthiAuto
DB_USER=your_db_user
DB_PASSWORD=change-me
# true = create the database on startup if it is missing (needs rights on master; skipped otherwise)
DB_CREATE_DATABASE=true
# encrypted connection; trust the server's own (self-signed) certificate
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true
DB_POOL_MAX=10

# ---- Login / security ----
# secret used to sign login tokens - keep it long and random
JWT_SCERET=change-me-long-random-string
# first platform admin, created automatically when the database has no admin yet
ADMIN_EMAIL=admin@sakthiauto.com
ADMIN_PASSWORD=change-me-Adm1n!

# ---- Frontend access ----
# Extra frontend addresses allowed to call the backend directly (CORS). Pages on the same server
# (<server-ip>:9021 calling <server-ip>:9022) are always allowed, so this is usually not needed.
# Format: full address = http(s)://host:port, no path, several separated by commas, no spaces needed.
#   one address:         CORS_ORIGINS=http://203.0.113.10:9021
#   public + VPN:        CORS_ORIGINS=http://203.0.113.10:9021,http://10.8.0.5:9021
#   with a domain/HTTPS: CORS_ORIGINS=https://sfs.sakthiauto.in,http://10.8.0.5:9021
#   allow anything:      CORS_ORIGINS=*        (only on a closed network)
# Only needed when frontend/.env has VITE_API_URL=http://<server>:9022 (calling the backend directly).
# With the default VITE_API_URL=/api the browser never makes cross-origin calls, so this can stay as is.
CORS_ORIGINS=http://localhost:5173,http://localhost:9021
# number of reverse proxies in front of the backend: 1 = the frontend's nginx; add 1 per extra
# load balancer / HTTPS gateway so login rate limiting sees the real client address
TRUST_PROXY_HOPS=1

# ---- Mail (SMTP) ----
SMTP_HOST=mail.abtlimited.com
SMTP_PORT=587
SMTP_USER=donotreply@sakthiauto.in
MAIL_PASS='change-me'
# Optional: connect to this IP instead of looking SMTP_HOST up in DNS (the certificate is still
# checked for SMTP_HOST). Only for mail.abtlimited.com, whose name points at an internal relay on the
# server's network. Delete this line when using another provider (Gmail / Office 365 / Brevo).
SMTP_CONNECT_IP=118.91.233.65

# Portal address for the buttons in emails.
# Leave EMPTY (recommended): each email links to the address the person was using, e.g. http://<server-ip>:9021.
# Set it only to force fixed address(es), comma separated, optionally labelled (first = main button):
#   APP_URL=Public|http://203.0.113.10:9021,VPN|http://10.8.0.5:9021
APP_URL=

# ---- Submissions ----
# largest solution PDF accepted, in MB
UPLOAD_MAX_MB=20
# time zone for submission dates and deadlines
APP_TIMEZONE=Asia/Kolkata
